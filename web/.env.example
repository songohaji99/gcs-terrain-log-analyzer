# Salin ke .env lalu isi sesuai kebutuhan. Semua opsional — tanpa key, pencarian memakai Photon + Nominatim + POI Overture lokal.
# CATATAN: variabel VITE_* ikut ter-bundle ke browser. Gunakan key yang dibatasi per domain/referrer di konsol provider.

# Urutan/prioritas provider (yang berkunci hanya aktif bila key-nya terisi)
VITE_GEOCODERS=photon,overture,nominatim,mapbox,maptiler,here,geoapify,google

# Self-host (disarankan untuk produksi/offline; menghindari batas fair-use server publik)
VITE_PHOTON_URL=
VITE_NOMINATIM_URL=
# Identitas kontak untuk Nominatim publik (kebijakan penggunaan OSMF)
VITE_NOMINATIM_EMAIL=
# Ekstrak POI Overture (dibuat oleh tools/build_overture_poi.py)
VITE_OVERTURE_URL=/data/overture_places.json

VITE_MAPBOX_TOKEN=
VITE_MAPTILER_KEY=
VITE_HERE_API_KEY=
VITE_GEOAPIFY_KEY=
VITE_GOOGLE_PLACES_KEY=
